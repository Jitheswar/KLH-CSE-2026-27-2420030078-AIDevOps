# Copy to .env and fill in values. Never commit .env itself.

# Path to the SQLite database file used by the platform on the host.
DATABASE_PATH=

# Seconds between automatic inventory-and-scan reconciliations.
INVENTORY_PERIOD_SECONDS=

# Base URL of the Prometheus instance scraping the cluster's cAdvisor
# endpoints. See `make prometheus-up`.
PROMETHEUS_URL=

# API key for DeepSeek, used by the Triage model port to score each
# Vulnerability's contextual urgency. Never commit a real value.
DEEPSEEK_API_KEY=

# Base URL of the DeepSeek API. Leave unset to use the default
# (https://api.deepseek.com).
DEEPSEEK_BASE_URL=
